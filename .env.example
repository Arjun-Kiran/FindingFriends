# Copy to .env on the droplet and fill in. Compose reads .env automatically.
#
# Everything here has a working default, so `docker compose up --build` serves
# a playable game on http://localhost with no .env at all. These are the values
# that have to change once the server has a real address.

# The origin players load the game from — scheme included, no trailing slash.
# Comma-separated for more than one (e.g. with and without www).
# Leave as * only for local testing: on a public address it lets any page
# anywhere drive somebody's game.
CORS_ALLOWED_ORIGINS=*

# Leave EMPTY for same-origin, which is what the bundled nginx serves and is
# almost certainly what you want. Set it only if the API ends up on a different
# host from the page. Baked in at build time, so changing it needs
# `docker compose build frontend`, not just a restart.
VITE_SERVER_URL=

# 80 locally if nothing else has it. Behind a host nginx doing TLS, point this
# somewhere free (e.g. 8080) and proxy to it.
HTTP_PORT=80

# DEBUG while bringing the droplet up, INFO once it is quiet.
LOG_LEVEL=INFO
